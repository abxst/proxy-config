<Window
    x:Class="ProxyConfig.App.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Proxy Config"
    Width="1320"
    Height="850"
    MinWidth="1080"
    MinHeight="720"
    WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Padding="20,14" BorderBrush="#30000000" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock FontSize="22" FontWeight="SemiBold" Text="Proxy Config" />
          <TextBlock Opacity="0.65" Text="NGINX &amp; Apache · offline configuration studio" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock VerticalAlignment="Center" Text="Server" />
          <ComboBox Width="130" ItemsSource="{Binding ServerEngines}" SelectedItem="{Binding SelectedEngine}" />
          <TextBlock VerticalAlignment="Center" Text="Target" />
          <ComboBox Width="140" ItemsSource="{Binding TargetPlatforms}" SelectedItem="{Binding SelectedTargetPlatform}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="220,*">
      <Border Grid.Column="0" Padding="14" BorderBrush="#30000000" BorderThickness="0,0,1,0">
        <StackPanel Spacing="6">
          <TextBlock Margin="8,4,8,12" FontSize="13" FontWeight="SemiBold" Opacity="0.65" Text="CONFIGURATION" />
          <Button HorizontalContentAlignment="Left" Command="{Binding ShowStaticSiteCommand}" Content="Static Website" />
          <Button HorizontalContentAlignment="Left" Command="{Binding ShowReverseProxyCommand}" Content="Reverse Proxy" />
          <Button HorizontalContentAlignment="Left" Command="{Binding ShowRedirectCommand}" Content="HTTP Redirect" />
          <Button HorizontalContentAlignment="Left" Command="{Binding ShowImportCommand}" Content="Import / Editor" />
          <Button HorizontalContentAlignment="Left" Command="{Binding ShowExplorerCommand}" Content="Directive Explorer" />
          <Separator Margin="0,12" />
          <TextBlock Margin="8,0" TextWrapping="Wrap" Opacity="0.58"
                     Text="Generate static sites, reverse proxies and redirects. Browse the public directive catalog offline." />
          <Separator Margin="0,12" />
          <TextBlock Margin="8,0" TextWrapping="Wrap" Opacity="0.55" FontSize="12"
                     Text="Multi-block editing, directive suggestions and undo/redo are available in Import / Editor. Typed argument forms are planned next." />
        </StackPanel>
      </Border>

      <Grid Grid.Column="1" IsVisible="{Binding IsGenerator}" ColumnDefinitions="420,*">
        <ScrollViewer Grid.Column="0">
          <StackPanel Margin="24" Spacing="14">
            <StackPanel Spacing="14" IsVisible="{Binding IsStaticSite}">
            <StackPanel Margin="0,0,0,8">
              <TextBlock FontSize="24" FontWeight="SemiBold" Text="Serve Static Files" />
              <TextBlock Margin="0,4,0,0" Opacity="0.65" TextWrapping="Wrap"
                         Text="Generate native server configuration from a filesystem path." />
            </StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Domain" />
            <TextBox Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="example.com" />
            <TextBlock FontWeight="SemiBold" Text="Listen port" />
            <NumericUpDown Minimum="1" Maximum="65535" Value="{Binding ListenPort}" />
            <TextBlock FontWeight="SemiBold" Text="Static directory" />
            <TextBox Text="{Binding StaticDirectory, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="/srv/www/example" />
            <TextBlock Margin="0,-8,0,0" FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                       Text="Path on the target server; it need not exist on this computer." />
            <TextBlock FontWeight="SemiBold" Text="URL path" />
            <TextBox Text="{Binding UrlPath, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="/" />
            <TextBlock FontWeight="SemiBold" Text="Index files" />
            <TextBox Text="{Binding IndexFiles, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="index.html index.htm" />
            <Separator Margin="0,6" />
            <CheckBox IsChecked="{Binding SpaFallback}" Content="SPA fallback to first index file" />
            <CheckBox IsChecked="{Binding DirectoryListing}" Content="Enable directory listing" />
            <CheckBox IsChecked="{Binding CacheStaticAssets}" Content="Cache static assets for 30 days" />
            <CheckBox IsChecked="{Binding Compression}" Content="Enable response compression" />
            </StackPanel>

            <StackPanel Spacing="14" IsVisible="{Binding IsHostPreset}">
              <TextBlock IsVisible="{Binding IsReverseProxy}" FontSize="24" FontWeight="SemiBold" Text="Reverse Proxy" />
              <TextBlock IsVisible="{Binding IsRedirect}" FontSize="24" FontWeight="SemiBold" Text="HTTP Redirect" />
              <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                         Text="Generate an NGINX server or Apache VirtualHost snippet. No deployment is performed." />

              <TextBlock FontWeight="SemiBold" Text="Domain" />
              <TextBox Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="example.com" />
              <TextBlock FontWeight="SemiBold" Text="Listen port" />
              <NumericUpDown Minimum="1" Maximum="65535" Value="{Binding ListenPort}" />
              <CheckBox Content="Enable TLS" IsChecked="{Binding EnableTls}" />

              <StackPanel Spacing="10" IsVisible="{Binding EnableTls}">
                <TextBlock FontWeight="SemiBold" Text="Certificate file on target server" />
                <TextBox Text="{Binding CertificateFile, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="/etc/ssl/certs/example.pem" />
                <TextBlock FontWeight="SemiBold" Text="Private key on target server" />
                <TextBox Text="{Binding PrivateKeyFile, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="/etc/ssl/private/example.key" />
              </StackPanel>

              <StackPanel Spacing="12" IsVisible="{Binding IsReverseProxy}">
                <Separator />
                <TextBlock FontWeight="SemiBold" Text="External URL path" />
                <TextBox Text="{Binding ProxyUrlPath, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="/api/" />
                <TextBlock FontWeight="SemiBold" Text="Upstream origin" />
                <TextBox Text="{Binding UpstreamUrl, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="http://127.0.0.1:3000" />
                <TextBlock FontSize="12" TextWrapping="Wrap" Opacity="0.6"
                           Text="HTTP(S) origin only; no path, query, credentials or fragment." />
                <CheckBox Content="Strip the external path prefix" IsChecked="{Binding StripPrefix}" />
                <CheckBox Content="Preserve incoming Host header" IsChecked="{Binding PreserveHost}" />
                <CheckBox Content="WebSocket upgrade (Apache 2.4.47+)" IsChecked="{Binding WebSocket}" />
                <TextBlock FontWeight="SemiBold" Text="Additional upstream request headers" />
                <TextBox Text="{Binding RequestHeadersText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" MinHeight="80" TextWrapping="Wrap"
                         PlaceholderText="X-Service: proxy-config" />
                <TextBlock FontSize="12" Opacity="0.6" Text="One Name: value pair per line." />
              </StackPanel>

              <StackPanel Spacing="12" IsVisible="{Binding IsRedirect}">
                <Separator />
                <TextBlock FontWeight="SemiBold" Text="Redirect target origin" />
                <TextBox Text="{Binding RedirectDestination, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="https://new.example.com" />
                <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                           Text="Preserves the original request path and query. Enter origin only (no path/query)." />
                <TextBlock FontWeight="SemiBold" Text="HTTP redirect status" />
                <ComboBox ItemsSource="{Binding RedirectStatuses}" SelectedItem="{Binding RedirectStatus}" />
              </StackPanel>

              <Separator />
              <TextBlock FontWeight="SemiBold" Text="Additional response headers" />
              <TextBox Text="{Binding ResponseHeadersText, UpdateSourceTrigger=PropertyChanged}"
                       AcceptsReturn="True" MinHeight="80" TextWrapping="Wrap"
                       PlaceholderText="X-Content-Type-Options: nosniff" />
              <TextBlock FontSize="12" Opacity="0.6" Text="One Name: value pair per line. Apache requires mod_headers." />
            </StackPanel>

            <Border IsVisible="{Binding ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Padding="12" CornerRadius="8" Background="#22FF4500">
              <TextBlock Foreground="OrangeRed" TextWrapping="Wrap" Text="{Binding ValidationMessage}" />
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="1" RowDefinitions="Auto,*">
          <Border Padding="20,14" BorderBrush="#30000000" BorderThickness="1,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock FontSize="17" FontWeight="SemiBold" Text="Live configuration preview" />
                <TextBlock Margin="0,3,0,0" Opacity="0.6" Text="Save the generated text as a .conf file." />
                <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="SeaGreen" Text="{Binding ExportStatus}" />
              </StackPanel>
              <Button Grid.Column="1" VerticalAlignment="Center" IsEnabled="{Binding CanExport}"
                      Click="SaveConfig_Click" Content="Export .conf" />
            </Grid>
          </Border>
          <TextBox Grid.Row="1" Margin="16" Padding="16" AcceptsReturn="True" IsReadOnly="True"
                   TextWrapping="NoWrap" FontFamily="Consolas" FontSize="14"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" Text="{Binding Preview}" />
        </Grid>
      </Grid>

      <Grid Grid.Column="1" IsVisible="{Binding IsExplorer}" ColumnDefinitions="360,*">
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*" Margin="18,20,8,16" RowSpacing="12">
          <StackPanel>
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Directive Explorer" />
            <TextBlock FontSize="12" TextWrapping="Wrap" Opacity="0.7"
                       Text="Documentation entries, not validated installed-server capabilities." />
          </StackPanel>
          <TextBox Grid.Row="1" Watermark="Search name, module, syntax or context"
                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
          <StackPanel Grid.Row="2" Spacing="6">
            <CheckBox Content="Include NGINX variables" IsChecked="{Binding IncludeVariables}" />
            <TextBlock FontSize="12" Opacity="0.65" Text="{Binding SearchResultCount}" />
          </StackPanel>
          <ListBox Grid.Row="3" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedDirective}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="4,6" Spacing="3">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                  <TextBlock Text="{Binding Module}" FontSize="11" Opacity="0.6" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>

        <ScrollViewer Grid.Column="1" Margin="10,20,24,16">
          <StackPanel Spacing="12" DataContext="{Binding SelectedDirective}">
            <TextBlock Text="{Binding Name}" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ServerLabel}" Opacity="0.8" />
            <Border Background="#173D91D1" Padding="12" CornerRadius="8">
              <TextBlock TextWrapping="Wrap" Text="Reference only: availability depends on version, build flags, loaded modules, platform and edition." />
            </Border>
            <TextBlock Text="Module" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Module}" TextWrapping="Wrap" />
            <TextBlock Text="Syntax" FontWeight="SemiBold" />
            <TextBox Text="{Binding Syntax}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" />
            <TextBlock Text="Context" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Context}" TextWrapping="Wrap" />
            <TextBlock Text="Default" FontWeight="SemiBold" />
            <TextBlock Text="{Binding DefaultValue}" TextWrapping="Wrap" />
            <TextBlock Text="Description" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
            <TextBlock Text="Status (Apache)" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
            <TextBlock Text="Compatibility" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Compatibility}" TextWrapping="Wrap" />
            <TextBlock Text="AllowOverride (Apache)" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Override}" TextWrapping="Wrap" />
            <TextBlock Text="Official documentation URL" FontWeight="SemiBold" />
            <TextBox Text="{Binding DocumentationUrl}" IsReadOnly="True" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid Grid.Column="1" IsVisible="{Binding IsImport}" ColumnDefinitions="395,*">
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto"
              Margin="18,20,8,16" RowSpacing="12">
          <StackPanel Spacing="6">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Import / Editor" />
            <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.7"
                       Text="Import .conf, manage multiple nested blocks and export without dropping unknown directives or comments." />
            <TextBlock Text="{Binding ImportFileName}" Opacity="0.6" FontSize="12" />
          </StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="7">
            <Button Click="ImportConfig_Click" Content="Open .conf" />
            <Button Command="{Binding ParseImportedCommand}" Content="Parse" />
            <Button Command="{Binding SelectRootScopeCommand}" Content="Root scope" />
            <Button Command="{Binding AppendGeneratedHostCommand}"
                    IsEnabled="{Binding CanAppendGeneratedHost}" Content="+ Preset" />
          </StackPanel>
          <TextBlock Grid.Row="2" Text="{Binding ImportSummary}" FontSize="12" Opacity="0.7" />
          <ListBox Grid.Row="3" ItemsSource="{Binding ImportedNodes}" SelectedItem="{Binding SelectedImportNode}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Margin="5,4" FontFamily="Consolas" Text="{Binding Display}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TabControl Grid.Row="4" MaxHeight="335">
            <TabItem Header="Edit / Arrange">
              <StackPanel Margin="6,10,6,6" Spacing="8">
                <TextBlock FontSize="12" TextWrapping="Wrap" Opacity="0.7"
                           Text="Select an AST node to replace, duplicate, remove or reorder it." />
                <TextBox Text="{Binding NodeReplacementText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="65" MaxHeight="100" />
                <Button Command="{Binding ApplyNodeEditCommand}" Content="Apply node replacement" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Command="{Binding DuplicateNodeCommand}" Content="Duplicate" />
                  <Button Command="{Binding RemoveNodeCommand}" Content="Remove" />
                  <Button Command="{Binding MoveNodeUpCommand}" Content="Move ↑" />
                  <Button Command="{Binding MoveNodeDownCommand}" Content="Move ↓" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Command="{Binding UndoEditCommand}" IsEnabled="{Binding CanUndo}" Content="Undo" />
                  <Button Command="{Binding RedoEditCommand}" IsEnabled="{Binding CanRedo}" Content="Redo" />
                </StackPanel>
              </StackPanel>
            </TabItem>
            <TabItem Header="+ Directive">
              <ScrollViewer MaxHeight="290">
                <StackPanel Margin="6,10,6,6" Spacing="7">
                  <TextBlock FontSize="12" TextWrapping="Wrap" Opacity="0.7"
                             Text="Search offline documentation, or type any directive manually." />
                  <TextBox PlaceholderText="Search directive..." Text="{Binding DirectiveSearchText, UpdateSourceTrigger=PropertyChanged}" />
                  <ListBox Height="88" ItemsSource="{Binding DirectiveSuggestions}"
                           SelectedItem="{Binding SelectedSuggestion}">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                          <TextBlock FontSize="11" Opacity="0.6" Text="{Binding Module}" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBox PlaceholderText="Directive name" Text="{Binding NewDirectiveName, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBox PlaceholderText="Arguments (without trailing semicolon)" Text="{Binding NewDirectiveArguments, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap" Text="{Binding DirectiveHint}" />
                  <Button Command="{Binding AddDirectiveCommand}" Content="Add directive to selected scope" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="+ Block">
              <StackPanel Margin="6,10,6,6" Spacing="10">
                <TextBlock FontSize="12" TextWrapping="Wrap" Opacity="0.7"
                           Text="Insert inside selected block; if a directive is selected, insert beside it." />
                <TextBlock FontSize="12" Text="{Binding EditorScopeContext}" />
                <TextBox PlaceholderText="Block name (server, location, Directory, VirtualHost, ...)"
                         Text="{Binding NewBlockName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox PlaceholderText="Block arguments (e.g. /api/ or *:80)"
                         Text="{Binding NewBlockArguments, UpdateSourceTrigger=PropertyChanged}" />
                <Button Command="{Binding AddBlockCommand}" Content="Add block to selected scope" />
                <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                           Text="Structural syntax is checked. The app does not guarantee semantic validity or module availability." />
              </StackPanel>
            </TabItem>
          </TabControl>
          <ScrollViewer Grid.Row="5" MaxHeight="95">
            <StackPanel Spacing="4">
              <TextBlock Foreground="OrangeRed" Text="{Binding ImportDiagnostics}" TextWrapping="Wrap" />
              <TextBlock FontSize="12" Foreground="OrangeRed" Text="{Binding ExportStatus}" TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <Grid Grid.Column="1" RowDefinitions="Auto,*">
          <Border Padding="20,14" BorderBrush="#30000000" BorderThickness="1,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock FontSize="17" FontWeight="SemiBold" Text="Configuration source" />
                <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                           Text="Edit text directly, then press Parse to refresh the AST. Export preserves the current text." />
              </StackPanel>
              <Button Grid.Column="1" VerticalAlignment="Center" IsEnabled="{Binding CanExport}"
                      Click="SaveConfig_Click" Content="Export .conf" />
            </Grid>
          </Border>
          <TextBox Grid.Row="1" Margin="16" Padding="16"
                   AcceptsReturn="True" TextWrapping="NoWrap"
                   FontFamily="Consolas" FontSize="13"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   Text="{Binding ImportText, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
